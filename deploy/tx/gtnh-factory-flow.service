[Unit]
Description=GTNH Factory Flow
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=gtnh-flow
Group=gtnh-flow
WorkingDirectory=/opt/gtnh-factory-flow/current
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3180
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=GTNH_PREWARM_ON_STARTUP=1
Environment=GTNH_MAX_LOADED_RECIPE_SHARDS=8
Environment=GTNH_MAX_HYDRATED_RECIPE_SUMMARIES=8000
Environment=NODE_OPTIONS=--max-old-space-size=1536
EnvironmentFile=/etc/gtnh-factory-flow/environment
ExecStart=/usr/bin/node /opt/gtnh-factory-flow/current/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
Nice=5
MemoryHigh=1800M
MemoryMax=2G
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/opt/gtnh-factory-flow/shared/cache

[Install]
WantedBy=multi-user.target
